// https://zed.dev/docs/configuring-zed
{
	"default_open_behavior": "new_window",
	"cli_default_open_behavior": "new_window",
	"diff_view_style": "unified",
	"on_last_window_closed": "quit_app",
	"when_closing_with_no_tabs": "keep_window_open",
	"show_edit_predictions": true,
	"telemetry": {
		"anthropic_retention": false,
		"diagnostics": false,
		"metrics": false,
	},
	"edit_predictions": {
		"provider": "zed",
		"open_ai_compatible_api": {
			"prompt_format": "zeta2",
			"api_url": "http://127.0.0.1:7748/v1/completions",
			"model": "zeta-2",
		},
	},
	"agent": {
		"tool_permissions": {
			"tools": {
				"create_directory": {
					"default": "allow",
				},
			},
		},
		"sidebar_side": "right",
		"dock": "right",
		"inline_assistant_model": {
			"provider": "wai",
			"model": "qwen-3.6-35b-a3b",
		},
		"favorite_models": [
			{
				"provider": "wai",
				"model": "minimax-m2.5",
				"enable_thinking": false,
			},
			{
				"provider": "wai",
				"model": "minimax-m2.7",
				"enable_thinking": false,
			},
			{
				"provider": "copilot_chat",
				"model": "claude-sonnet-4.6",
				"enable_thinking": true,
				"effort": "high",
			},
			{
				"provider": "wai",
				"model": "qwen-3.6-35b-a3b",
				"enable_thinking": false,
			},
		],
		"show_turn_stats": true,
		"play_sound_when_agent_done": "always",
		"default_profile": "write",
		"enabled": true,
		"enable_feedback": false,
		"default_model": {
			"effort": "high",
			"enable_thinking": true,
			"provider": "copilot_chat",
			"model": "claude-sonnet-4.6",
		},
	},
	"agent_servers": {
		"pi-acp": {
			"type": "registry",
		},
		"opencode": {
			"type": "extension",
			"favorite_models": [
				"wai/minimax-m2.5",
				"wai/minimax-m2.7",
				"wai/qwen-3.6-35b-a3b",
			],
		},
	},
	"language_models": {
		"openai_compatible": {
			"wai": {
				"api_url": "https://ai.willow.sh/v1",
				"available_models": [
					{
						"name": "minimax-m2.5",
						"display_name": "Minimax M2.5",
						"max_tokens": 131072,
						"max_output_tokens": 32768,
						"max_completion_tokens": 32768,
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": true,
							"prompt_cache_key": false,
							"chat_completions": true,
						},
					},
					{
						"name": "minimax-m2.7",
						"display_name": "Minimax M2.7",
						"max_tokens": 65536,
						"max_output_tokens": 16384,
						"max_completion_tokens": 16384,
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": true,
							"prompt_cache_key": false,
							"chat_completions": true,
						},
					},
					{
						"name": "qwen-3.6-35b-a3b",
						"display_name": "Qwen 3.6 35B A3B",
						"max_tokens": 131072,
						"max_output_tokens": 16384,
						"max_completion_tokens": 16384,
						"reasoning_effort": "medium",
						"capabilities": {
							"tools": true,
							"images": true,
							"parallel_tool_calls": true,
							"prompt_cache_key": false,
							"chat_completions": true,
						},
					},
				],
			},
			"local": {
				"api_url": "http://127.0.0.1:7748/v1",
				"available_models": [
					{
						"name": "gemma-4-E4B-it",
						"display_name": "Gemma 4 E4B",
						"max_tokens": 131072,
						"max_output_tokens": 16384,
						"max_completion_tokens": 16384,
						"reasoning_effort": "medium",
						"capabilities": {
							"tools": true,
							"images": true,
							"parallel_tool_calls": true,
							"prompt_cache_key": false,
							"chat_completions": true,
						},
					},
				],
			},
		},
	},
	"context_servers": {
		"atproto.md": {
			"enabled": false,
			"url": "https://atproto.md/mcp",
		},
		"searxng": {
			"enabled": false,
			"url": "https://ai.willow.sh/mcp/searxng",
			"headers": {
				"Authorization": "",
			},
		},
		"svelte-mcp": {
			"enabled": false,
			"remote": false,
			"settings": {},
		},
		"dotprompts": {
			"enabled": false,
			"url": "https://dotprompts.com/mcp",
		},
		"tmcp-web": {
			"enabled": false,
			"url": "https://tmcp-web.willowdev.workers.dev/mcp",
		},
	},
	"collaboration_panel": {
		"dock": "right",
		"button": false,
	},
	"use_smartcase_search": true,
	"search": {
		"center_on_match": true,
		"button": false,
	},
	"project_panel": {
		"hide_root": false,
		"git_status": true,
		"file_icons": true,
		"dock": "right",
		"indent_size": 16,
		"entry_spacing": "standard",
		"diagnostic_badges": true,
	},
	"git_panel": {
		"dock": "right",
		"entry_primary_click_action": "project_diff",
		"collapse_untracked_diff": true,
		"tree_view": true,
		"group_by": "none",
		"commit_title_max_length": 72,
		"show_count_badge": true,
		"folder_icons": false,
	},
	"outline_panel": {
		"dock": "right",
		"button": false,
	},
	"ui_font_size": 16,
	"buffer_font_size": 14,
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "Serendipity Sunset V1",
	},
	"icon_theme": {
		"mode": "dark",
		"light": "Catppuccin Mocha",
		"dark": "Catppuccin Mocha",
	},
	"buffer_font_family": "Comic Mono",
	"preferred_line_length": 90,
	"auto_update": false,
	"tab_size": 4,
	"terminal": {
		"font_family": "Comic Mono",
		"font_size": 14,
		"cursor_shape": "bar",
		"blinking": "on",
		"bell": "system",
		"toolbar": {
			"breadcrumbs": false,
		},
	},
	"auto_install_extensions": {
		"catppuccin-icons": true,
		"docker-compose": true,
		"dockerfile": true,
		"svelte": true,
		"svelte-mcp": true,
		"vue": true,
		"html": true,
		"deno": true,
		"scss": true,
		"sql": true,
		"toml": true,
		"astro": true,
		"basher": true,
		"just-ls": true,
		"caddyfile": true,
		"kdl": true,
		"mdx": true,
		"oxc": true,
		"just": true,
		"opencode": true,
		"make": true,
		"emmet": true,
	},
	"minimap": {
		"show": "never",
	},
	"toolbar": {
		"agent_review": true,
		"code_actions": true,
	},
	"title_bar": {
		"show_branch_status_icon": true,
		"show_sign_in": false,
		"button_layout": "",
	},
	"tabs": {
		"file_icons": true,
		"git_status": true,
		"show_diagnostics": "all",
	},
	"file_types": {
		"JSON": ["prettierrc"],
		"Markdown": ["*.svx"],
	},
	"journal": {
		"hour_format": "hour24",
	},
	"auto_signature_help": false,
	"show_signature_help_after_edits": false,
	"hover_popover_delay": 200,
	"languages": {
		"Go": {
			"formatter": "language_server",
		},
		"Rust": {
			"formatter": "language_server",
		},
	},
	"format_on_save": "on",
	"hard_tabs": true,
	"prettier": {
		"allowed": true,
		"singleQuote": true,
		"quoteProps": "as-needed",
		"trailingComma": "all",
		"bracketSpacing": true,
		"bracketSameLine": false,
		"arrowParens": "always",
		"semi": true,
		"useTabs": true,
		"tabWidth": 4,
		"svelteAllowShorthand": true,
		"svelteIndentScriptAndStyle": true,
	},
	"diagnostics": {
		"button": true,
		"include_warnings": true,
		"inline": {
			"enabled": true,
		},
	},
	"git": {
		"inline_blame": {
			"show_commit_summary": true,
			"enabled": true,
		},
	},
	"calls": {
		"mute_on_join": true,
		"share_on_join": false,
	},
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true,
			},
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"typeAware": true,
				},
			},
		},
		"Caddyfile": {
			"format_on_save": "on",
			"tab_size": 4,
			"formatter": {
				"external": {
					"command": "caddy",
					"arguments": ["fmt", "-c", "-"],
				},
			},
		},
	},
	"ssh_connections": [
		{
			"host": "whale",
			"projects": [
				{
					"paths": ["/home/willow"],
				},
			],
		},
		{
			"host": "sauron",
			"projects": [
				{
					"paths": ["/home/ghost"],
				},
			],
		},
	],
}
