{
	"$schema": "https://opencode.ai/config.json",
	"plugins": ["@sveltejs/opencode@0.1.16"],
	"update": "notify",
	"mcp": {
		"servers": {
			"tmcp-web": {
				"type": "remote",
				"url": "https://tmcp-web.willowdev.workers.dev/mcp",
				"disabled": true
			},
			"dotprompts": {
				"type": "remote",
				"url": "https://dotprompts.com/mcp",
				"disabled": true
			},
			"searxng": {
				"type": "remote",
				"url": "https://ai.willow.sh/mcp/searxng",
				"disabled": true,
				"headers": {
					"Authorization": "Basic"
				}
			},
			"atproto.md": {
				"type": "remote",
				"url": "https://atproto.md/mcp",
				"disabled": true
			}
		}
	},
	"model": "wai/minimax-m2.7",
	"agents": {
		"title": {
			"model": "local/gemma-4-E4B-it"
		}
	},
	"providers": {
		"wai": {
			"package": "aisdk:@ai-sdk/openai-compatible",
			"settings": {
				"baseURL": "https://ai.willow.sh/v1"
			},
			"models": {
				"minimax-m2.5": {
					"name": "MiniMax M2.5",
					"cost": { "input": 0.3, "output": 1.2, "cache": { "read": 0.03 } },
					"capabilities": {
						"tools": true
					}
				},
				"minimax-m2.7": {
					"name": "MiniMax M2.7",
					"cost": { "input": 0.3, "output": 1.2, "cache": { "read": 0.06 } },
					"capabilities": {
						"tools": true,
						"input": ["text", "audio"],
						"output": ["text"]
					}
				},
				"qwen-3.6-35b-a3b": {
					"name": "Qwen 3.6 35B A3B",
					"cost": { "input": 0.33, "output": 1.95 },
					"capabilities": {
						"tools": true,
						"input": ["text", "image"],
						"output": ["text"]
					}
				}
			}
		},
		"local": {
			"package": "aisdk:@ai-sdk/openai-compatible",
			"settings": {
				"baseURL": "http://127.0.0.1:7748/v1"
			},
			"models": {
				"gemma-4-E4B-it": {
					"name": "Gemma 4 E4B",
					"capabilities": {
						"input": ["text", "image", "audio"],
						"output": ["text"]
					}
				}
			}
		}
	}
}
